{
    "name": "vulcano-wave-nodes",
    "version": "1.0.0",
    "description": "helmut.cloud wave node catalog for Vulcano",
    "main": "index.js",
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "bundle": "esbuild index.ts --bundle --format=cjs --platform=node --outfile=bundle.js",
        "bundle:debug": "esbuild index.ts --sourcemap --bundle --format=cjs --platform=node --outfile=bundle.js",
        "build": "node scripts/build.mjs ../bundle.js",
        "debug": "npm run bundle:debug && node scripts/debug.mjs",
        "spec": "npm run bundle && node scripts/spec.mjs",
        "link": "curl \"http://localhost:6968/api/agent/v1/modules/dev-wave/wave/debug?waveNodeFolder=${PWD// /%20}\"",
        "lint": "npx eslint",
        "format": "npx prettier . --write",
        "test": "jest"
    },
    "keywords": [
        "catalog",
        "helmut.cloud",
        "vulcano",
        "wave"
    ],
    "author": "MoovIT Software Products GmbH",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.9.0",
        "hcloud-sdk": "^20.1.0",
        "wave-engine": "^2.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.21",
        "@types/tar": "^6.1.13",
        "chalk": "^5.4.1",
        "esbuild": "^0.25.1",
        "eslint": "^9.27.0",
        "globals": "^16.1.0",
        "prettier": "3.5.3",
        "ts-jest": "^29.3.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.1"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 140,
        "overrides": [
            {
                "files": [
                    "*.js",
                    "*.mjs",
                    "*.ts"
                ],
                "options": {
                    "trailingComma": "es5"
                }
            },
            {
                "files": [
                    "*.yaml"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "esbuild"
        ],
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
